# Configuracao do Backend - EduReforco
# Copie este arquivo para .env e preencha com suas chaves reais

# Chave secreta para JWT (gere uma string aleatoria segura)
SECRET_KEY=sua-chave-secreta-aqui-troque-por-uma-segura

# Configuracao do Banco de Dados
DATABASE_URL=sqlite:///./edureforco.db

# API da Groq para IA (obtenha em: https://console.groq.com/)
GROQ_API_KEY=sua-chave-groq-aqui

# Ambiente (development ou production)
ENVIRONMENT=development

# CORS - Frontend URL (ajuste conforme necessario)
FRONTEND_URL=http://localhost:3000
